PORT=4000
# Keep credentials only in backend/.env, never in frontend public environment variables.
DATABASE_URL=
APP_ORIGIN=http://localhost:3100
NODE_ENV=development
# Local synthetic role accounts only. Ignored in production or with DATABASE_URL.
DEMO_MODE=false
# First-admin bootstrap only; unset ADMIN_PASSWORD after bootstrap.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
